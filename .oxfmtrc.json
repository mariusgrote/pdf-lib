{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "src/packages/standard-fonts/*.compressed.json",
    "src/packages/standard-fonts/font_metrics/**",
    "src/packages/standard-fonts/encoding_metrics/**",
    "assets/**"
  ]
}
