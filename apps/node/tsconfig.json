{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2020",
    "module": "commonjs",
    "composite": false,
    "rootDir": "../..",
    "incremental": true,
    "tsBuildInfoFile": "./tsBuildInfo.json",
    "outDir": "../node-build",

    /* Strict Type-Checking Options */
    "strict": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Module Resolution Options */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    // Resolve @mariusgrote/pdf-lib to src/ so type-checking needs no build.
    // tsconfig.build.json drops this and compiles against the built package.
    "customConditions": ["@mariusgrote/source"]
  },
  "include": ["./**/*"],
  "exclude": ["node_modules"]
}
