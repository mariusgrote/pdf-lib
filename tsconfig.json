{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2015",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./build",
    "rootDir": "./src",
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./tsBuildInfo.json",
    "removeComments": false,
    "importHelpers": true,
    "isolatedModules": false,
    "newLine": "LF",
    "resolveJsonModule": true,
    /* Strict Type-Checking Options */
    "strict": true,
    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* Module Resolution Options */
    "paths": {
      "src/*": ["./src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "jsx": "react"
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": [
    ".github",
    ".vscode",
    "apps",
    "assets",
    "cjs",
    "docs",
    "node_modules",
    "tests",
    "src/packages/*/dist",
    "src/packages/*/scripts",
    "src/packages/*/*.d.ts"
  ]
}
