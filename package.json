{
  "name": "@mariusgrote/pdf-lib",
  "version": "2.11.0",
  "description": "Create and modify PDF files with JavaScript",
  "author": "Marius Grote (https://github.com/mariusgrote)",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "@mariusgrote/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./upng": {
      "@mariusgrote/source": "./src/packages/upng/index.ts",
      "types": "./dist/upng.d.mts",
      "default": "./dist/upng.mjs"
    },
    "./standard-fonts": {
      "@mariusgrote/source": "./src/packages/standard-fonts/index.ts",
      "types": "./dist/standard-fonts.d.mts",
      "default": "./dist/standard-fonts.mjs"
    },
    "./package.json": "./package.json"
  },
  "contributors": [
    "Andrew Dillon <andrew.dillon.j@gmail.com>",
    "François Billioud (https://github.com/Sharcoux)",
    "Matheus Santos (https://github.com/matheus-santos)",
    "Cantoo (https://github.com/cantoo-scribe)",
    "jerp (https://github.com/jerp)",
    "Greg Bacchus (https://github.com/gregbacchus)",
    "Mickael Lecoq (https://github.com/mlecoq)",
    "Philip Murphy (https://github.com/philipjmurphy)",
    "Dmitry Kozliuk (https://github.com/PlushBeaver)",
    "Said Amezyane (https://github.com/samezyane)",
    "Georges Gabereau (https://github.com/multiplegeorges)",
    "Gerard Smit (https://github.com/GerardSmit)",
    "jlmessenger (https://github.com/jlmessenger)",
    "thebenlamm (https://github.com/thebenlamm)",
    "cshenks (https://github.com/cshenks)",
    "James Woodrow (https://github.com/jwoodrow)",
    "Guillaume Grossetie (https://github.com/Mogztter)",
    "Philipp Tessenow (https://github.com/tessi)",
    "Tim Kräuter (https://github.com/timKraeuter)",
    "Richard Bateman (https://github.com/taxilian)",
    "Sebastian Martinez (https://github.com/sebastinez)",
    "soadzoor (https://github.com/soadzoor)",
    "Slobodan Babic (https://github.com/bockoblur)",
    "Zach Toben (https://github.com/ztoben)",
    "Zack Sheppard (https://github.com/zackdotcomputer)",
    "DkDavid (https://github.com/DkDavid)",
    "Bj Tecu (https://github.com/btecu)",
    "Brent McSharry (https://github.com/mcshaz)",
    "Tim Knapp (https://github.com/duffyd)",
    "Ching Chang (https://github.com/ChingChang9)",
    "Phakorn Kiong (https://github.com/PhakornKiong)",
    "Donald Ness (https://github.com/programmarchy)",
    "Remus DRAICA (https://github.com/remdra)",
    "David Abdala (https://github.com/adnsistemas)",
    "Eran Ohayon (https://github.com/erano067)"
  ],
  "scripts": {
    "release:check": "pnpm fmt:check && pnpm lint && pnpm clean && pnpm test && pnpm build && pnpm apps:build && pnpm test:smoke",
    "get:version": "node --eval 'console.log(require(`./package.json`).version)'",
    "clean": "node -e \"for (const p of ['coverage', 'dist', 'apps/node-build', 'out.pdf']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "test": "vitest run",
    "testw": "vitest",
    "testc": "vitest run --coverage && open coverage/index.html",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "standard-fonts:afm": "node src/packages/standard-fonts/scripts/fonts/parse.ts",
    "standard-fonts:encodings": "node src/packages/standard-fonts/scripts/encodings/parse.ts",
    "standard-fonts:metrics": "pnpm standard-fonts:afm && pnpm standard-fonts:encodings",
    "build": "tsdown",
    "apps:build": "tsc --build apps/node/tsconfig.build.json",
    "apps:node": "pnpm apps:build && node apps/node-build/index.js",
    "apps:web": "vite --open /apps/web/test1.html",
    "test:smoke": "node ./scripts/smoke-test.mjs"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "fflate": "^0.8.2",
    "node-html-better-parser": "^1.5.9"
  },
  "peerDependencies": {
    "html-entities": "^2.3.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@cantoo/fontkit": "^2.0.12",
    "@types/culori": "^4.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/mariusgrote/pdf-lib#readme",
  "repository": "git+https://github.com/mariusgrote/pdf-lib.git",
  "bugs": {
    "url": "https://github.com/mariusgrote/pdf-lib/issues"
  },
  "keywords": [
    "pdf-lib",
    "pdf",
    "document",
    "create",
    "modify",
    "creation",
    "modification",
    "edit",
    "editing",
    "typescript",
    "javascript",
    "library"
  ],
  "files": [
    "dist/",
    "src/",
    "LICENSE.md",
    "README.md"
  ]
}
